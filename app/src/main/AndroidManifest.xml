<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.abel.os4freeformx">

    <uses-sdk
        android:minSdkVersion="33"
        android:targetSdkVersion="36" />

    <!-- 配置界面需要列出已安装应用供用户勾选（Android 11+ 包可见性限制） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:allowBackup="true"
        android:extractNativeLibs="false">

        <activity
            android:name="com.abel.os4freeformx.SettingsActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:theme="@style/AppTheme"
            android:excludeFromRecents="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.abel.os4freeformx.AppPickerActivity"
            android:label="选择应用"
            android:exported="false"
            android:theme="@style/PickerTheme"
            android:excludeFromRecents="true" />

        <provider
            android:name="com.abel.os4freeformx.StoreProvider"
            android:authorities="com.abel.os4freeformx.store"
            android:exported="true"
            android:grantUriPermissions="true" />
    </application>
</manifest>
