<?xml version="1.0" encoding="utf-8"?>
<!--
  应用图标前景：一张主窗口 + 右下角叠一张小窗卡片 + 底部手势条。
  隐喻模块本身：freeform 小窗 / 分屏 / 手势导航增强。

  2026-10-23 用户要求：两个窗口缩到原来的 80%（以两窗口联合区域中心 (59,56) 缩放，保持构图关系）。
    主窗口 30..74/30..66 → 35.8..71/35.2..64（圆角 8→6.4）
    小窗框 56..88/54..82 → 56.6..82.2/54.4..76.8（圆角 8→6.4）
    小窗内容 → 58.2..77.4/55.8..75（圆角 6→4.8）
  底部手势条同步上提到 y82..88（原来 92..98 超出自适应图标 72dp 安全区，
  圆形遮罩会把它裁掉；上提后落在安全区内且与窗口间距更紧凑）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 主窗口（圆角矩形，缩 80%） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M42.2,35.2 h22.4 a6.4,6.4 0 0 1 6.4,6.4 v16 a6.4,6.4 0 0 1 -6.4,6.4 h-22.4 a6.4,6.4 0 0 1 -6.4,-6.4 v-16 a6.4,6.4 0 0 1 6.4,-6.4 z" />

    <!-- 小窗卡片外框：用背景深色垫一圈，制造「叠在主窗口上」的层次 -->
    <path
        android:fillColor="#16233F"
        android:pathData="M63,54.4 h12.8 a6.4,6.4 0 0 1 6.4,6.4 v9.6 a6.4,6.4 0 0 1 -6.4,6.4 h-12.8 a6.4,6.4 0 0 1 -6.4,-6.4 v-9.6 a6.4,6.4 0 0 1 6.4,-6.4 z" />

    <!-- 小窗卡片内容 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M63,55.8 h9.6 a4.8,4.8 0 0 1 4.8,4.8 v9.6 a4.8,4.8 0 0 1 -4.8,4.8 h-9.6 a4.8,4.8 0 0 1 -4.8,-4.8 v-9.6 a4.8,4.8 0 0 1 4.8,-4.8 z" />

    <!-- 底部手势条（小白条）：20x6 胶囊，落在安全区内 -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.92"
        android:pathData="M44,82 h14 a3,3 0 0 1 0,6 h-14 a3,3 0 0 1 0,-6 z" />
