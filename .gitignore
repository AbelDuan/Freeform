/recon/
fw/
tools/tmp/
*.jar
!app/libs/*.jar
cap_demo.txt
trace_all.txt

# ── 设备侧大日志与截图（不入库）─────────────────────────────
# 原始 logcat 抓取 64MB+；截图数百 KB~MB 级
/logs/
*.png
*.jpg
*.jpeg
anr*.txt
mod_clean.log
module_readable.log
*_decoded.log

# ── 测试运行时输出（脚本产物，非源码）───────────────────────
/_out/
t17_*.png
t17_*.txt
small_*.png
frame*.txt
