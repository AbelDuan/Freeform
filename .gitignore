# ── 构建产物 / 签名密钥（不入库）─────────────────────────────
build/
/dist/*.idsig
/dist/*.apk
/dist/*.bundle
/keystore/
.env

# ── 重型逆向产物（体积大，按需本地重生成）────────────────────
